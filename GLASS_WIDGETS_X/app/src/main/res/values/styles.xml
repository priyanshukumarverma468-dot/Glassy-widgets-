<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#08090D</item>
        <item name="android:navigationBarColor">#08090D</item>
        <item name="android:colorAccent">#D8C5FF</item>
        <item name="android:windowBackground">#08090D</item>
    </style>
    <style name="QuickLaunchButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#17131F</item>
        <item name="android:background">#D8C5FF</item>
    </style>
</resources>
