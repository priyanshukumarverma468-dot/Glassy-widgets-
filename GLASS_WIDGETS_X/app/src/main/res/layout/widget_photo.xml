<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/glass_card">
    <ImageView android:id="@+id/photo_image" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="centerCrop"
        android:contentDescription="Selected photo"/>
    <TextView android:id="@+id/photo_placeholder" android:layout_width="match_parent"
        android:layout_height="match_parent" android:gravity="center"
        android:text="Choose a photo in widget setup" android:textColor="#FFFFFFFF"
        android:textSize="12sp" android:padding="12dp"/>
</FrameLayout>
